SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Groq: Whisper V3 Large Turbo (https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Stripe: billing portal + checkout. Create products/prices in Dashboard; add price IDs here.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PRICE_ID_MONTHLY=price_...   # $20/mo billed monthly
STRIPE_PRICE_ID_ANNUAL=price_...    # $10/mo billed yearly
# Optional: base URL for Stripe return (e.g. https://yourapp.com). Defaults to request host.
# APP_URL=https://yourapp.com

# Redis (optional). e.g. redis://localhost:6379 or redis://default:password@host:port
REDIS_URL=redis://localhost:6379
